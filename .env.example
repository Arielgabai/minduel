# ------------------------------------------------------------------
# MINDUEL — Variables d'environnement (DÉVELOPPEMENT LOCAL)
# Copier ce fichier en `.env` puis adapter. Ne JAMAIS committer `.env`.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
# Voir docs/environment-variables.md pour le détail de chaque variable.
# ------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Base de données : PostgreSQL (via docker compose up -d db) ---
# Port hôte 5433 (mappé sur 5432 du conteneur) pour éviter un conflit avec un
# PostgreSQL déjà installé localement.
DATABASE_URL="postgresql://minduel:minduel@localhost:5433/minduel?schema=public"
# DIRECT_URL : uniquement si votre fournisseur utilise un pooler (Neon/Supabase/PgBouncer).
# DIRECT_URL="postgresql://minduel:minduel@localhost:5433/minduel?schema=public"

# --- Sessions : secret >= 32 caractères (générer une vraie valeur en prod) ---
SESSION_SECRET="dev-secret-change-me-in-production-please-32chars-min"

# --- Fournisseur d'IA : "demo" (déterministe, aucun appel payant) ou "openai" ---
AI_PROVIDER=demo
OPENAI_API_KEY=""
# Modèle Realtime GA (speech-to-speech WebRTC), compatible /v1/realtime/client_secrets.
OPENAI_REALTIME_MODEL="gpt-realtime"
# Transcription diarisée du pipeline appel -> exercice.
# Valeur imposée si AI_PROVIDER=openai : un modèle non diarisant fait échouer le
# démarrage (pas de locuteurs, et chunking_strategy rejeté en HTTP 400).
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-transcribe-diarize"
# Timeout dédié à la requête de transcription de fichier (envoi audio + traitement
# OpenAI + réponse JSON). Défaut 15 min, borné [1 min ; 60 min]. Sans override, le
# défaut undici de 300 s coupe systématiquement sur les fichiers de plusieurs Mo.
# N'affecte PAS Realtime / WebRTC (autres canaux).
OPENAI_TRANSCRIPTION_TIMEOUT_MS=900000
# Nombre maximum de tentatives pour un job TRANSCRIBE_RECORDING (défaut : 2).
# La transcription est coûteuse (audio complet renvoyé à chaque essai) ; au-delà,
# un retry manuel manager est plus approprié qu'une boucle automatique.
TRANSCRIBE_RECORDING_MAX_ATTEMPTS=2
# Battement de cœur du worker sur un job long : rafraîchit lockedAt pour empêcher
# un autre worker de voler le lock pendant une transcription de plusieurs minutes.
WORKER_HEARTBEAT_MS=30000
# Âge à partir duquel un job RUNNING est considéré orphelin (worker crashé ou
# redéployé) et peut être récupéré par un autre worker. Doit rester supérieur à
# OPENAI_TRANSCRIPTION_TIMEOUT_MS pour ne pas voler le lock d'un worker sain.
WORKER_STALE_LOCK_MS=1200000
OPENAI_EVALUATION_MODEL="gpt-4o-mini"
# Analyse structurée + génération de scénario (Responses API, JSON strict).
OPENAI_ANALYSIS_MODEL="gpt-5.6-terra"
OPENAI_SCENARIO_MODEL="gpt-5.6-terra"
# Effort de raisonnement de l'analyse : minimal|low|medium|high.
OPENAI_ANALYSIS_REASONING_EFFORT=medium
# Voix de sortie GA (ex. marin, cedar, alloy…).
OPENAI_REALTIME_VOICE="marin"

# --- Stockage audio : "local" (dev) ou "s3" (prod) ---
STORAGE_DRIVER=local
AUDIO_STORAGE_DIR="./storage"
# S3 (si STORAGE_DRIVER=s3) :
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""          # vide pour AWS S3 ; URL pour R2/MinIO
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false

# --- Limites & rétention ---
SIGNED_URL_TTL_SECONDS=300
# MAX_AUDIO_UPLOAD_MB est la variable canonique du pipeline appel -> exercice
# (les appels réels durent 15-20 min). MAX_AUDIO_SIZE_MB reste un alias rétro-compatible.
MAX_AUDIO_UPLOAD_MB=100
MAX_AUDIO_SIZE_MB=25
# AUDIO_RETENTION_DAYS est canonique ; RECORDING_RETENTION_DAYS reste un alias.
AUDIO_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=90
# Seuil de confiance d'attribution des locuteurs (sinon on demande au manager).
SPEAKER_ASSIGNMENT_CONFIDENCE_THRESHOLD=0.75

# --- Observabilité ---
LOG_LEVEL=info

# --- Seed de démonstration (comptes demo1234) ---
# En production, le seed refuse de s'exécuter sauf ALLOW_DEMO_SEED=true.
ALLOW_DEMO_SEED=false
