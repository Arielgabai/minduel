# ------------------------------------------------------------------
# MINDUEL — Variables d'environnement (DÉVELOPPEMENT LOCAL)
# Copier ce fichier en `.env` puis adapter. Ne JAMAIS committer `.env`.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
# Voir docs/environment-variables.md pour le détail de chaque variable.
# ------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Base de données : PostgreSQL (via docker compose up -d db) ---
# Port hôte 5433 (mappé sur 5432 du conteneur) pour éviter un conflit avec un
# PostgreSQL déjà installé localement.
DATABASE_URL="postgresql://minduel:minduel@localhost:5433/minduel?schema=public"
# DIRECT_URL : uniquement si votre fournisseur utilise un pooler (Neon/Supabase/PgBouncer).
# DIRECT_URL="postgresql://minduel:minduel@localhost:5433/minduel?schema=public"

# --- Sessions : secret >= 32 caractères (générer une vraie valeur en prod) ---
SESSION_SECRET="dev-secret-change-me-in-production-please-32chars-min"

# --- Fournisseur d'IA : "demo" (déterministe, aucun appel payant) ou "openai" ---
AI_PROVIDER=demo
OPENAI_API_KEY=""
# Modèle Realtime GA (speech-to-speech WebRTC), compatible /v1/realtime/client_secrets.
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
OPENAI_EVALUATION_MODEL="gpt-4o-mini"
# Voix de sortie GA (ex. marin, cedar, alloy…).
OPENAI_REALTIME_VOICE="marin"

# --- Stockage audio : "local" (dev) ou "s3" (prod) ---
STORAGE_DRIVER=local
AUDIO_STORAGE_DIR="./storage"
# S3 (si STORAGE_DRIVER=s3) :
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""          # vide pour AWS S3 ; URL pour R2/MinIO
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false

# --- Limites & rétention ---
SIGNED_URL_TTL_SECONDS=300
MAX_AUDIO_SIZE_MB=25
RECORDING_RETENTION_DAYS=90

# --- Observabilité ---
LOG_LEVEL=info

# --- Seed de démonstration (comptes demo1234) ---
# En production, le seed refuse de s'exécuter sauf ALLOW_DEMO_SEED=true.
ALLOW_DEMO_SEED=false
