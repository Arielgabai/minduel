# ------------------------------------------------------------------
# MINDUEL — Variables d'environnement (exemple)
# Copier ce fichier en `.env` puis adapter. Ne JAMAIS committer `.env`.
# ------------------------------------------------------------------

# Base de données (SQLite pour le dev local, zéro config)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions (généré aléatoirement en prod)
SESSION_SECRET="dev-secret-change-me-in-production-please-32chars-min"

# Mode démo : quand aucune clé OpenAI n'est fournie, l'app fonctionne
# entièrement avec des providers déterministes (voix simulée, évaluation locale).
# Mettre "true" pour forcer le mode démo même si une clé est présente.
MINDUEL_DEMO_MODE="true"

# ------------------------------------------------------------------
# Intégration OpenAI (optionnelle — laisser vide pour le mode démo)
# La clé longue durée reste EXCLUSIVEMENT côté serveur, jamais envoyée
# au navigateur. Les sessions Realtime utilisent un secret client éphémère.
# ------------------------------------------------------------------
OPENAI_API_KEY=""

# Modèles centralisés côté serveur (surchargeables)
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_EVALUATION_MODEL="gpt-4o-mini"
OPENAI_REALTIME_VOICE="verse"

# ------------------------------------------------------------------
# Stockage audio privé
# En dev : filesystem local (dossier ./storage hors /public).
# En prod : interface S3 compatible (MinIO / S3).
# ------------------------------------------------------------------
AUDIO_STORAGE_DRIVER="local"       # local | s3
AUDIO_STORAGE_DIR="./storage"
AUDIO_MAX_UPLOAD_MB="50"

# S3 (si AUDIO_STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="minduel-recordings"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Durée de conservation configurable des enregistrements (jours)
RECORDING_RETENTION_DAYS="90"
