// MINDUEL — Schéma de données (Prisma + PostgreSQL)
// Multi-tenant : toute donnée métier porte un organizationId et est isolée côté serveur.
// Les enums sont représentés par des String contraints applicativement (voir src/lib/enums.ts)
// afin de rester portables et d'éviter des migrations lourdes ; les horodatages sont
// stockés en ISO 8601 (String) et traités comme tels dans toute l'application.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Pour un fournisseur utilisant un pooler (Neon, Supabase, PgBouncer…),
  // décommentez la ligne suivante et définissez DIRECT_URL pour les migrations :
  // directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String  @id @default(uuid())
  name                 String
  slug                 String  @unique
  isActive             Boolean @default(true)
  isDemo               Boolean @default(false)
  // LOT P2 : au plus une organisation propriétaire technique du catalogue
  // pédagogique global (thèmes, niveaux, exercices, PromptBundles, Skills).
  // Contrainte DB : index unique partiel WHERE isPlatformCatalog = true.
  // Les utilisateurs / simulations / résultats de cette org ne sont pas globaux.
  isPlatformCatalog    Boolean @default(false)
  // Réglages de confidentialité / conservation
  retentionDays        Int     @default(90)
  allowManagerPlayback Boolean @default(true)
  createdAt            String
  updatedAt            String

  memberships    TeamMembership[]
  users          User[]
  programs       TrainingProgram[]
  scenarios      Scenario[]
  recordings     CallRecording[]
  knowledgeItems KnowledgeItem[]
  rubrics        EvaluationRubric[]
  simulations    Simulation[]
  auditEvents    AuditEvent[]
  assignments    ScenarioAssignment[]
  callAnalyses   CallAnalysis[]
  promptBundles  PromptBundle[]

  skillCategories      SkillCategory[]
  skillSections        SkillSection[]
  skillArticles        SkillArticle[]
  skillArticleMappings SkillArticleMapping[]

  missionThemes MissionTheme[]
  missionStages MissionStage[]

  @@index([slug])
}

model User {
  id             String  @id @default(uuid())
  organizationId String?
  email          String  @unique
  passwordHash   String
  fullName       String
  // PLATFORM_ADMIN | MANAGER | TELEPRO
  role           String  @default("TELEPRO")
  isActive       Boolean @default(true)
  // Mot de passe temporaire affiché au manager (invitation simulée)
  tempPassword   String?
  streakDays     Int     @default(0)
  lastActiveDay  String?
  createdAt      String
  updatedAt      String

  organization         Organization?        @relation(fields: [organizationId], references: [id])
  membership           TeamMembership?
  createdScenarios     Scenario[]           @relation("ScenarioAuthor")
  assignmentsAsTelepro ScenarioAssignment[] @relation("AssignmentTelepro")
  assignmentsAsManager ScenarioAssignment[] @relation("AssignmentManager")
  uploadedRecordings   CallRecording[]
  // LOT Q3A : appels réels dont le télépro est le sujet (distinct de uploaderId).
  ownedRealCalls       CallRecording[]      @relation("CallRecordingTelepro")
  simulations          Simulation[]
  auditEvents          AuditEvent[]
  sessions             Session[]

  @@index([organizationId])
  @@index([email])
  // LOT Q3A : ancre pour FK composite CallRecording(teleproId, organizationId).
  @@unique([id, organizationId])
}

model Session {
  id        String @id @default(uuid())
  userId    String
  token     String @unique
  expiresAt String
  createdAt String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model TeamMembership {
  id             String @id @default(uuid())
  organizationId String
  userId         String @unique
  role           String @default("TELEPRO")
  createdAt      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model TrainingProgram {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      String
  updatedAt      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenarios    Scenario[]

  @@index([organizationId])
}

model Scenario {
  id                      String  @id @default(uuid())
  organizationId          String
  programId               String?
  authorId                String?
  name                    String
  slug                    String?
  missionLevel            Int     @default(1)
  sortOrder               Int     @default(0)
  // LOT Q2 : score minimum de validation (0–100) pour débloquer le niveau suivant.
  passingScore            Int     @default(60)
  // Catalogue Missions (lot N1) : classement optionnel et avatar de prospect.
  // Additifs et nullables : les exercices existants restent « Non classé ».
  missionStageId          String?
  prospectAvatarKey       String?
  publishedPromptBundleId String? @unique
  campaign                String?
  callType                String  @default("VENTE") // VENTE | PITCH_INVESTISSEUR | ENTRETIEN_EMBAUCHE
  offer                   String?
  prospectProfile         String?
  initialSituation        String?
  objective               String?
  level                   String  @default("MOYEN") // FACILE | MOYEN | DIFFICILE
  personality             String?
  // JSON stringifiés
  allowedObjections       String? // string[]
  secretInfos             String? // {question, answer}[]
  successConditions       String?
  failureConditions       String?
  targetDurationSec       Int     @default(300)
  status                  String  @default("DRAFT") // DRAFT | REVIEW_REQUIRED | PUBLISHED | ARCHIVED
  // Références aux connaissances approuvées injectées
  knowledgeRefs           String? // string[] d'ids KnowledgeItem
  // Provenance (exercice généré depuis un appel modèle)
  sourceRecordingId       String? @unique // 1 exercice par appel (idempotence à la génération)
  sourceAnalysisId        String?
  generatedByModel        String?
  promptVersion           String?
  // Champs générés (JSON) pour un scénario riche et contextuel
  traineeBrief            String? // brief remis au commercial (contexte, objectif)
  aiProspect              String? // JSON: persona IA (comportement, ton, révélations interdites)
  relationshipHistory     String? // JSON: historique fictif de la relation
  expectedNextSteps       String? // JSON: string[] des étapes attendues
  targetSkills            String? // JSON: string[] compétences ciblées
  coachingReference       String? // JSON: repères de coaching (bonnes pratiques retenues)
  createdAt               String
  updatedAt               String

  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program               TrainingProgram?     @relation(fields: [programId], references: [id])
  author                User?                @relation("ScenarioAuthor", fields: [authorId], references: [id])
  sourceRecording       CallRecording?       @relation("ScenarioSourceRecording", fields: [sourceRecordingId], references: [id])
  publishedPromptBundle PromptBundle?        @relation("PublishedPromptBundle", fields: [publishedPromptBundleId], references: [id], onDelete: SetNull)
  promptBundles         PromptBundle[]       @relation("ScenarioPromptBundles")
  rubric                EvaluationRubric?
  assignments           ScenarioAssignment[]
  simulations           Simulation[]
  // FK composite : scenario.organizationId === missionStage.organizationId.
  // Restrict (jamais Cascade / SetNull) : supprimer un niveau ne doit jamais
  // supprimer ni déclasser silencieusement un exercice. Le déclassement passe
  // par l'API admin (missionStageId = null) avant toute suppression de niveau.
  // Unicité (missionStageId, organizationId) : un niveau = au plus un exercice.
  missionStage          MissionStage?        @relation(fields: [missionStageId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, slug])
  @@unique([missionStageId, organizationId])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, missionLevel, sortOrder])
  @@index([organizationId, missionStageId])
}

// Bundle de prompts versionné par exercice (scénario).
// artifacts : JSON Record<PromptKind, { body, contentType }>.
model PromptBundle {
  id             String  @id @default(uuid())
  organizationId String
  scenarioId     String
  version        Int
  status         String  @default("DRAFT") // DRAFT | PUBLISHED | SUPERSEDED
  label          String?
  createdById    String?
  createdAt      String
  publishedAt    String?
  artifacts      String
  contentHash    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenario     Scenario     @relation("ScenarioPromptBundles", fields: [scenarioId], references: [id], onDelete: Cascade)
  publishedFor Scenario?    @relation("PublishedPromptBundle")
  simulations  Simulation[]

  @@unique([scenarioId, version])
  @@index([organizationId])
  @@index([scenarioId, status])
}

model ScenarioAssignment {
  id             String  @id @default(uuid())
  organizationId String
  scenarioId     String
  teleproId      String
  managerId      String?
  status         String  @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | COMPLETED
  createdAt      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenario     Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  telepro      User         @relation("AssignmentTelepro", fields: [teleproId], references: [id], onDelete: Cascade)
  manager      User?        @relation("AssignmentManager", fields: [managerId], references: [id])

  @@unique([scenarioId, teleproId])
  @@index([organizationId])
  @@index([teleproId])
}

model CallRecording {
  id                        String   @id @default(uuid())
  organizationId            String
  uploaderId                String?
  // LOT Q3A : propriétaire métier TELEPRO d'un appel réel (null = legacy / manager).
  teleproId                 String?
  // LOT Q3A : null = historique ; MANUAL_UPLOAD = appel réel télépro.
  source                    String?
  // LOT Q3A : horodatage serveur de la confirmation de droit (jamais fourni par le client).
  consentConfirmedAt        String?
  title                     String
  campaign                  String?
  callOutcome               String? // VENTE | REFUS | RAPPEL | RDV | AUTRE
  language                  String   @default("fr")
  tags                      String? // JSON string[]
  managerNote               String?
  consent                   Boolean  @default(false)
  consentAt                 String? // horodatage ISO du consentement (traçabilité RGPD)
  useAsModel                Boolean  @default(true) // utiliser cet appel comme appel modèle (génération d'exercice)
  storageKey                String? // clé de stockage privé (jamais public)
  mimeType                  String?
  sizeBytes                 Int      @default(0)
  durationSec               Int      @default(0)
  // Métadonnées audio (ffprobe, best-effort ; null si ffprobe indisponible)
  audioChannels             Int?
  audioSampleRate           Int?
  audioCodec                String?
  audioBitrate              Int?
  // Statut métier du pipeline (voir RecordingStatus dans src/lib/enums.ts) :
  // PENDING_UPLOAD | UPLOADED | PREPROCESSING | TRANSCRIBING | ANALYZING
  // | WAITING_FOR_CLARIFICATION | GENERATING_EXERCISE | REVIEW_REQUIRED | READY | FAILED
  status                    String   @default("UPLOADED")
  errorMessage              String?
  // Résultats détectés (surfacés dans la liste manager, remplis par le pipeline)
  detectedCallType          String?
  callTypeConfidence        Float?
  referenceSuitabilityScore Int?
  usableAsReference         Boolean?
  // Clarifications minimales demandées au manager (JSON), voir clarify route
  clarificationQuestions    String? // JSON: [{id, question, importance, options?}]
  clarificationAnswers      String? // JSON: {[questionId]: answer}
  enabled                   Boolean  @default(true)
  processingHash            String? // idempotence
  createdAt                 String
  updatedAt                 String

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader          User?           @relation(fields: [uploaderId], references: [id])
  // FK composite multi-tenant : telepro et appel partagent organizationId.
  // Restrict : ne jamais SET NULL organizationId. Legacy teleproId=null autorisé.
  telepro           User?           @relation("CallRecordingTelepro", fields: [teleproId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transcript        Transcript?
  analysis          CallAnalysis?
  generatedScenario Scenario?       @relation("ScenarioSourceRecording")
  knowledgeItems    KnowledgeItem[]

  @@index([organizationId])
  @@index([status])
  @@index([teleproId])
  @@index([organizationId, teleproId])
  @@index([source])
}

model Transcript {
  id                          String  @id @default(uuid())
  recordingId                 String  @unique
  language                    String  @default("fr")
  // Copie JSON héritée (compat) : [{speaker:"AGENT"|"PROSPECT", text, startMs, endMs}].
  // La source de vérité diarisée est désormais la table relationnelle TranscriptSegment.
  segments                    String
  // Attribution des locuteurs (identifie commercial vs client à partir de la diarisation)
  commercialSpeakerId         String?
  customerSpeakerId           String?
  speakerAssignmentConfidence Float?
  speakerAssignmentRationale  String?
  provider                    String? // ex : "openai" | "demo"
  model                       String? // ex : gpt-4o-transcribe-diarize
  createdAt                   String

  recording CallRecording       @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  turns     TranscriptSegment[]
}

// Segments diarisés (relationnels car liés à des timestamps et référencés comme preuves
// par l'analyse via evidenceSegmentIds). speakerId provient du fournisseur de diarisation.
model TranscriptSegment {
  id             String  @id @default(uuid())
  transcriptId   String
  idx            Int     @default(0) // ordre stable
  speakerId      String // identifiant locuteur brut (ex : "speaker_0")
  role           String? // AGENT | PROSPECT (rempli après attribution), null si inconnu
  startMs        Int     @default(0)
  endMs          Int     @default(0)
  text           String
  anonymizedText String? // texte anonymisé (PII remplacées par des variables)
  confidence     Float?

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
  @@index([transcriptId, idx])
}

model KnowledgeItem {
  id             String  @id @default(uuid())
  organizationId String
  recordingId    String?
  type           String // OBJECTION | GOOD_PRACTICE | BAD_PRACTICE | DISCOVERY_QUESTION | VOCABULARY | SCRIPT_STEP | COMPLIANCE_RULE
  title          String
  content        String
  sourceExcerpt  String?
  startMs        Int     @default(0)
  endMs          Int     @default(0)
  confidence     Float   @default(0)
  reviewStatus   String  @default("PENDING") // PENDING | APPROVED | REJECTED
  enabled        Boolean @default(true)
  createdAt      String
  updatedAt      String

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recording    CallRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reviewStatus])
}

model EvaluationRubric {
  id             String  @id @default(uuid())
  organizationId String
  scenarioId     String? @unique
  name           String  @default("Grille par défaut")
  // JSON: [{key, label, weight, description?, observableSignals?[], sourcePracticeIds?[]}] total 100
  // key/label/weight sont préservés pour compat avec l'évaluation existante.
  criteria       String
  createdAt      String
  updatedAt      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenario     Scenario?    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Analyse structurée d'un appel modèle (1:1 avec CallRecording).
// Colonnes indexables pour la liste/filtrage ; JSON pour les structures variables.
// LOT Q3A : overallScore + coachingPayload pour les appels réels télépro
// (contrat distinct de l'analyse de référence pédagogique).
model CallAnalysis {
  id                        String  @id @default(uuid())
  organizationId            String
  recordingId               String  @unique
  // Colonnes indexables
  callType                  String? // voir CallType (COLD_PROSPECTING, EXISTING_CUSTOMER, ...)
  callTypeConfidence        Float?
  relationshipStage         String? // NEW | EXISTING | RENEWAL | ...
  referenceSuitabilityScore Int?    @default(0)
  usable                    Boolean @default(true)
  language                  String  @default("fr")
  model                     String?
  promptVersion             String?
  // Structures variables (JSON)
  summary                   String? // synthèse courte, anonymisée
  customerProfile           String? // JSON
  commercialStrategy        String? // JSON (bonnes pratiques retenues avec evidenceSegmentIds)
  ambiguities               String? // JSON: [{id, question, importance}]
  referenceSuitability      String? // JSON (justification du score)
  // LOT Q3A : score global coaching (null si non calculé / indisponible)
  overallScore              Int?
  // LOT Q3A : JSON RealCallAnalysisResult (Zod) — null pour les appels modèle
  coachingPayload           String?
  createdAt                 String
  updatedAt                 String

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recording    CallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([callType])
}

model Simulation {
  id                  String  @id @default(uuid())
  organizationId      String
  scenarioId          String
  teleproId           String
  mode                String  @default("DEMO") // DEMO | REALTIME
  status              String  @default("CREATED") // CREATED | IN_PROGRESS | COMPLETED | ABANDONED | FAILED
  prospectName        String?
  startedAt           String?
  endedAt             String?
  durationSec         Int     @default(0)
  outcome             String? // VENTE | REFUS | RAPPEL | RDV
  promptBundleId      String?
  promptBundleVersion Int?
  promptContentHash   String?
  createdAt           String
  updatedAt           String

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenario     Scenario              @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  telepro      User                  @relation(fields: [teleproId], references: [id], onDelete: Cascade)
  promptBundle PromptBundle?         @relation(fields: [promptBundleId], references: [id], onDelete: Restrict)
  turns        SimulationTurn[]
  evaluation   SimulationEvaluation?

  @@index([organizationId])
  @@index([teleproId])
  @@index([scenarioId])
  @@index([promptBundleId])
}

model SimulationTurn {
  id           String @id @default(uuid())
  simulationId String
  role         String // AGENT | PROSPECT | SYSTEM
  content      String
  atMs         Int    @default(0)
  createdAt    String

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
}

model SimulationEvaluation {
  id            String  @id @default(uuid())
  simulationId  String  @unique
  overallScore  Int     @default(0)
  summary       String?
  // JSON strengths/improvements/advice/betterFormulation/keyMoments/outcome
  strengths     String?
  improvements  String?
  advice        String?
  betterExample String?
  keyMoments    String?
  outcome       String?
  createdAt     String

  simulation  Simulation   @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  skillScores SkillScore[]
}

model SkillScore {
  id             String  @id @default(uuid())
  evaluationId   String
  key            String
  label          String
  score          Int     @default(0)
  maxScore       Int     @default(0)
  rationale      String?
  evidence       String?
  recommendation String?

  evaluation SimulationEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

// ---------------------------------------------------------------------------
// Bibliothèque Skills (catalogue pédagogique administrable, lot J).
// Hiérarchie : SkillCategory → SkillSection → SkillArticle.
// Statuts applicatifs : DRAFT | PUBLISHED | ARCHIVED (voir src/lib/skillsContent.ts).
// Le contenu des articles est un JSON de blocs strictement validés côté serveur
// (jamais de HTML arbitraire). Distinct de SkillScore (scores d'évaluation).
// ---------------------------------------------------------------------------

model SkillCategory {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  // Clé d'icône contrôlée (liste fermée applicative, jamais de SVG arbitraire)
  iconKey        String  @default("book")
  sortOrder      Int     @default(0)
  status         String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdById    String?
  createdAt      String
  updatedAt      String
  publishedAt    String?
  archivedAt     String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     SkillSection[]
  articles     SkillArticle[]

  @@unique([organizationId, slug])
  // Ancre FK composite : empêche une section/article d'une autre org
  @@unique([id, organizationId])
  @@index([organizationId, status, sortOrder])
}

model SkillSection {
  id             String  @id @default(uuid())
  organizationId String
  categoryId     String
  name           String
  slug           String
  description    String?
  sortOrder      Int     @default(0)
  status         String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdById    String?
  createdAt      String
  updatedAt      String
  publishedAt    String?
  archivedAt     String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // FK composite : section.organizationId === category.organizationId
  category     SkillCategory  @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  articles     SkillArticle[]

  @@unique([categoryId, slug])
  @@unique([id, organizationId])
  // Ancre FK article → section + catégorie + org (article.categoryId === section.categoryId)
  @@unique([id, organizationId, categoryId])
  @@index([organizationId])
  @@index([categoryId, status, sortOrder])
}

model SkillArticle {
  id             String  @id @default(uuid())
  organizationId String
  categoryId     String
  sectionId      String
  title          String
  slug           String
  summary        String?
  // JSON string[] (libellés courts, validés côté serveur)
  tags           String?
  readingMinutes Int     @default(3)
  sortOrder      Int     @default(0)
  status         String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  // JSON : blocs de contenu structurés, validés par SkillArticleContentSchema
  content        String
  createdById    String?
  createdAt      String
  updatedAt      String
  publishedAt    String?
  archivedAt     String?

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // FK composites : même organisation que catégorie et section ; catégorie = section.categoryId
  category      SkillCategory         @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  section       SkillSection          @relation(fields: [sectionId, organizationId, categoryId], references: [id, organizationId, categoryId], onDelete: Restrict)
  skillMappings SkillArticleMapping[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([sectionId, status, sortOrder])
  @@index([categoryId])
}

// Mapping normalisé article ↔ clé de compétence (SkillScore.key / rubriques).
// Permet de retrouver les articles publiés associés à un axe de compétence.
model SkillArticleMapping {
  id             String @id @default(uuid())
  organizationId String
  articleId      String
  skillKey       String
  createdAt      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // FK composite : mapping.organizationId === article.organizationId
  article      SkillArticle @relation(fields: [articleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([articleId, skillKey])
  @@index([organizationId, skillKey])
}

// ---------------------------------------------------------------------------
// Catalogue Missions (lots N1/N4) : Thème → niveaux (un exercice = un niveau).
// MissionStage reste le modèle technique du niveau ; cardinalité 1:1 avec Scenario.
// Statuts applicatifs : DRAFT | PUBLISHED | ARCHIVED (voir src/lib/missionCatalog.ts).
// Aucun contenu de démonstration n'est créé : le catalogue est intégralement
// administrable par PLATFORM_ADMIN. Les exercices non classés restent visibles.
// ---------------------------------------------------------------------------

model MissionTheme {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  // Clé d'icône contrôlée (liste fermée applicative, jamais de SVG arbitraire)
  iconKey        String  @default("target")
  sortOrder      Int     @default(0)
  status         String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdById    String?
  createdAt      String
  updatedAt      String
  publishedAt    String?
  archivedAt     String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       MissionStage[]

  @@unique([organizationId, slug])
  // Ancre FK composite : empêche un niveau d'une autre organisation
  @@unique([id, organizationId])
  @@index([organizationId, status, sortOrder])
}

model MissionStage {
  id             String  @id @default(uuid())
  organizationId String
  themeId        String
  name           String
  slug           String
  description    String?
  levelNumber    Int     @default(1)
  sortOrder      Int     @default(0)
  status         String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdById    String?
  createdAt      String
  updatedAt      String
  publishedAt    String?
  archivedAt     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // FK composite : stage.organizationId === theme.organizationId
  theme        MissionTheme @relation(fields: [themeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  // N4 : un niveau = au plus un exercice (relation 1:1 optionnelle).
  scenario     Scenario?

  @@unique([themeId, slug])
  // Un numéro de niveau unique par thème : l'ordre pédagogique reste lisible.
  @@unique([themeId, levelNumber])
  // Ancre FK composite : empêche un exercice d'une autre organisation
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([themeId, status, sortOrder])
}

model AuditEvent {
  id             String  @id @default(uuid())
  organizationId String
  actorId        String?
  action         String // UPLOAD | KNOWLEDGE_APPROVE | KNOWLEDGE_REJECT | EXPORT | DELETE_RECORDING | ...
  targetType     String?
  targetId       String?
  metadata       String? // JSON (jamais le contenu complet des conversations)
  createdAt      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([action])
}

// File de tâches persistante (PostgreSQL) pour les traitements longs/asynchrones.
// Consommée par un worker séparé (`npm run worker`) avec verrouillage
// (SELECT ... FOR UPDATE SKIP LOCKED), retries et backoff.
// L'unicité (type, targetId) garantit l'idempotence : une seule tâche active par cible.
model ProcessingJob {
  id             String    @id @default(uuid())
  organizationId String
  type           String // RECORDING_PIPELINE | ...
  targetId       String // ex : id de CallRecording
  status         String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAfter       DateTime  @default(now()) // backoff : ne pas exécuter avant cette date
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([type, targetId])
  @@index([status, runAfter])
  @@index([organizationId])
}
