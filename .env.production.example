# ------------------------------------------------------------------
# MINDUEL — Variables d'environnement (PRODUCTION / BÊTA)
# MODÈLE sans aucun secret réel. À configurer dans l'hébergeur (Render, etc.),
# JAMAIS dans le dépôt. Voir docs/deployment-render.md.
# ------------------------------------------------------------------

NODE_ENV=production
# URL publique HTTPS de l'application (domaine Render ou personnalisé).
APP_URL=https://votre-app.onrender.com

# --- Base de données PostgreSQL managée ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
# DIRECT_URL : uniquement avec un pooler (Neon/Supabase). Décommenter aussi
# directUrl dans prisma/schema.prisma si utilisé.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require

# --- Sessions : générer un secret aléatoire >= 32 octets ---
#   openssl rand -base64 48
SESSION_SECRET=CHANGEZ_MOI_secret_aleatoire_de_32_caracteres_minimum

# --- Fournisseur d'IA ---
# "demo" = déterministe (aucun appel payant). "openai" = Realtime réel (clé requise).
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Timeout dédié à la transcription de fichier ; 15 min pour tenir un audio de
# plusieurs Mo. N'affecte PAS Realtime/WebRTC.
OPENAI_TRANSCRIPTION_TIMEOUT_MS=900000
# Retries stricts pour la transcription (coûteuse en I/O + modèle) : 2 tentatives
# max, puis retry manuel manager en cas de nouvel échec.
TRANSCRIBE_RECORDING_MAX_ATTEMPTS=2
# Heartbeat du worker pour tenir le lock d'un job long ; stale lock à 20 min
# (> transcription timeout de 15 min pour ne jamais voler un worker sain).
WORKER_HEARTBEAT_MS=30000
WORKER_STALE_LOCK_MS=1200000
OPENAI_EVALUATION_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_SCENARIO_MODEL=gpt-5.6-terra
OPENAI_ANALYSIS_REASONING_EFFORT=medium
OPENAI_REALTIME_VOICE=marin

# --- Stockage objet privé OBLIGATOIRE en production (uploads refusés sinon) ---
STORAGE_DRIVER=s3
S3_BUCKET=minduel-recordings
S3_REGION=eu-west-3
S3_ENDPOINT=              # vide pour AWS S3 ; URL pour Cloudflare R2 / MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false # true pour MinIO / certains services compatibles

# --- Limites & rétention ---
SIGNED_URL_TTL_SECONDS=300
# Canonique (appels réels 15-20 min) + alias rétro-compatible.
MAX_AUDIO_UPLOAD_MB=100
MAX_AUDIO_SIZE_MB=25
AUDIO_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=90
# Attribution des locuteurs : en dessous, on demande au manager de trancher.
SPEAKER_ASSIGNMENT_CONFIDENCE_THRESHOLD=0.75

# --- Observabilité ---
LOG_LEVEL=info

# --- Seed de démonstration : NE PAS activer en vraie production ---
# Mettre true UNIQUEMENT pour un environnement de démonstration assumé.
ALLOW_DEMO_SEED=false
